# 本文件只是「环境变量清单」，程序只读进程环境变量，不会自动加载本文件。
# 若要用 .env 文件，请自行用 dotenv 类工具注入；真实 .env 不要提交到仓库。
# 不要在这里填写任何真实口令。

DJANGO_SECRET_KEY=replace-me-with-a-random-string
DJANGO_DEBUG=true

# mysql（生产/常规开发） 或 sqlite（本地烟测，无需 MySQL 服务）
DB_ENGINE=mysql
DB_NAME=collab
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
